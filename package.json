{
  "name": "@jordyvanvorselen/pi-monitor",
  "version": "0.3.0",
  "description": "Watch long-running processes like GitHub Actions runs in the background. Pi wakes only when something worth knowing happens.",
  "type": "module",
  "license": "MIT",
  "author": "Jordy van Vorselen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordyvanvorselen/pi-monitor.git"
  },
  "homepage": "https://github.com/jordyvanvorselen/pi-monitor#readme",
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "monitor",
    "background",
    "github-actions",
    "extension"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "record:dock": "node scripts/record-dock.ts",
    "record:herdr": "node scripts/record-herdr.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . && npm run format",
    "lint:fix": "eslint . --fix && npm run format:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "typebox": "^1.4.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  }
}
